{
  "name": "@ankhorage/graph-cytoscape",
  "version": "0.1.1",
  "type": "module",
  "description": "Thin Cytoscape adapter for the canonical Ankhorage graph model.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/graph-cytoscape.git"
  },
  "homepage": "https://github.com/ankhorage/graph-cytoscape#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/graph-cytoscape/issues"
  },
  "keywords": [
    "ankhorage",
    "cytoscape",
    "graph",
    "graph-adapter",
    "typescript"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "examples"
  ],
  "exports": {
    ".": {
      "types": "./dist/graphCytoscape.d.ts",
      "import": "./dist/graphCytoscape.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "docs": "paradox",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "prepack": "bun run build",
    "test": "bun test src",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "version-packages": "ankhorage-changeset version",
    "knip:check": "ankhorage-knip"
  },
  "dependencies": {
    "@ankhorage/graph": "^0.1.0"
  },
  "peerDependencies": {
    "cytoscape": "^3.34.3"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.13.0",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.1",
    "@types/node": "^25.6.0",
    "cytoscape": "^3.34.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "bun@1.4.2"
}
